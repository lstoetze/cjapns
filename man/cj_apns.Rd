# --- Conditional separable monotonicity ---
pref_dat <- cnj_cand[!duplicated(cnj_cand$ResponseId),
                      c("ResponseId", "Att_borders", "Att_eurobonds",
                        "Att_immucard", "Att_schools", "Att_tracingapp")]
