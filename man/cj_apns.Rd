               tasks = ~ time, profile = ~ profile, se = "none")
res

# --- MAPNS on all tasks ---
res_all <- cj_apns(vote ~ borders + eurobonds + immucard + schools,
                   data = cnj_cand, id = ~ ResponseId, tasks = ~ time,
                   profile = ~ profile, informative = "all", se = "none")

