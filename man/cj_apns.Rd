prefs <- make_preferences(pref_dat, id = ~ ResponseId, type = "binary")

res_cond <- cj_apns(
  vote ~ borders + eurobonds + immucard + schools,
  data = cnj_cand, id = ~ ResponseId,
  tasks = ~ time, profile = ~ profile,
  assumption = "both", preferences = prefs,
  se = "parametric", B = 500
)
summary(res_cond)
plot(res_cond)
}

